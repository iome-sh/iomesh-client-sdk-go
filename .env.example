# local/dev placeholder — hosted brokers expect a CP-minted org_+cuid2
IOMESH_ORG=org_example
IOMESH_TENANT=dept.engineering
IOMESH_DEPARTMENT=engineering
# omit IOMESH_WORKSPACE — broker root-default; never invent workspaces[0]
# IOMESH_BEARER_TOKEN=

# Connector webhook template
CONNECTOR_SDK_SECRET=
CONNECTOR_ID=acme-crm
